<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle rules for CS 213 Fall 2026 Coding Standard

    The following rules will catch the following:
    - Tabs instead of spaces for indentation
    - Lines longer than 78 characters
    - Missing Javadoc on classes/interfaces/enums and on methods/constructors
    - Missing @param or @return tags in Javadoc
    - Methods longer than 40 lines
    - Non-camelCase names for fields, local variables, parameters, and methods
    - Non-PascalCase class names
    - Constants not in ALL_CAPS_WITH_UNDERSCORES
    - Magic numbers other than 0 and 1
    - Incorrect indentation (not 4 spaces)
    - Missing whitespace around operators, or after commas/semicolons
    - More than one statement per line
    - Missing or extra blank lines between members
    - Class members out of order (constants/statics, fields, constructors, methods)

    The following rules will NOT catch the following:
    - Multiple public classes in one file, or a file name not matching its public class
    - Missing or incorrect @author tag on the class-level comment
    - Constructors not ordered by number of parameters, or main() not placed last
    - Private methods not grouped before public methods within a section
    - Excessive or useless or zero inline // comments
    - Whether a Javadoc's first sentence is a good summary
    - Whether the code actually compiles, runs, or produces correct output
-->

<module name="Checker">

    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- Formatting #2: only use spaces, not tabs -->
    <module name="FileTabCharacter"/>

    <!-- Formatting #3: wrap long lines -->
    <module name="LineLength">
        <property name="max" value="78"/>
    </module>

    <module name="TreeWalker">

        <!-- Rule 2: every top-level class/interface/enum needs a comment block -->
        <module name="MissingJavadocType">
            <property name="scope" value="package"/>
        </module>

        <!-- Rule 3: every method and constructor needs a comment block,
             regardless of visibility -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="private"/>
            <property name="minLineCount" value="-1"/>
        </module>

        <!-- Rule 1 & 3: @param for every parameter, @return whenever the
             method returns something -->
        <module name="JavadocMethod">
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
        </module>

        <!-- "lose points if any method exceeds 40 lines" -->
        <module name="MethodLength">
            <property name="max" value="40"/>
            <property name="countEmpty" value="true"/>
        </module>

        <!-- instance variables: camelCase, at least 2 characters -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
        </module>

        <!-- local variables: same rule, but a single letter is allowed as a
             for-loop counter (i, j, k, ...) -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
            <property name="allowOneCharVarInForLoop" value="true"/>
        </module>

        <!-- parameters: same camelCase, no single letters -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
        </module>

        <!-- methods: camelCase  -->
        <module name="MethodName"/>

        <!-- classes: PascalCase -->
        <module name="TypeName"/>

        <!-- constants: ALL_CAPS_WITH_UNDERSCORES -->
        <module name="ConstantName"/>

        <!-- no magic numbers besides 0 and 1 -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="0, 1"/>
        </module>

        <!-- 3-4 space indentation, no tabs -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="caseIndent" value="4"/>
        </module>

        <!-- a space before and after every operator -->
        <module name="WhitespaceAround"/>

        <!-- a space after every comma and semicolon -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI"/>
        </module>

        <!-- at most one statement per line -->
        <module name="OneStatementPerLine"/>

        <!-- exactly one blank line between methods/constructors/nested classes;
             fields may sit next to each other with no blank line required -->
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
        </module>

        <!-- broad member order: constants/statics -> instance vars ->
             constructors -> methods. -->
        <module name="DeclarationOrder">
            <property name="ignoreModifiers" value="true"/>
        </module>

    </module>
</module>
